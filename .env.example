# MongoDB connection string (MongoDB Atlas or local)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mailer

# At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Base64-encoded 32-byte key used to encrypt stored credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Resend account-level management key. Used only to create/verify/look up domains
# and (optionally) create domain-restricted sending keys. Never sent to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Webhook signing secret from the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# Shared secret for internal scheduler/worker cron endpoints. Generate a random string.
CRON_SECRET=replace-with-a-long-random-string

# Maximum delivery jobs processed per worker invocation.
WORKER_BATCH_SIZE=100

# Public application URL.
APP_URL=http://localhost:3000

# Fallback sender identity (per-domain defaults override these).
EMAIL_FROM_NAME=Mailer
EMAIL_FROM_ADDRESS=sender@example.com
EMAIL_REPLY_TO=sender@example.com
